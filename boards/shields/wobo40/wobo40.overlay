/*
 * WoBo40 - Seeed XIAO nRF52840 Plus 用シールド定義
 *
 * - 47キー + 1Uトラックボール
 * - キースキャン: 8行x6列マトリクス (行2段重ね方式, IC不要)
 *   物理4行x12列を左右2ブロックに分け、右ブロック(C7-C12)は
 *   行線を別の4本 (電気的な行4-7) にして列線を左ブロックと共用する。
 * - トラックボール: PMW3610 (SPI0, 3線SPI: MOSI/MISO同一ピン)
 *
 * ピンアサイン (回路図と一致):
 *   D0  (P0.02) : 電池電圧監視 ADC (AIN0) ※任意, ファーム未使用
 *   D1  (P0.03) : 行0
 *   D2  (P0.28) : 行1
 *   D3  (P0.29) : 行2
 *   D4  (P0.04) : PMW3610 SCLK
 *   D5  (P0.05) : PMW3610 SDIO
 *   D6  (P1.11) : PMW3610 nCS
 *   D7  (P1.12) : PMW3610 MOTION (割り込み)
 *   D8  (P1.13) : 行7
 *   D9  (P1.14) : 列0
 *   D10 (P1.15) : 列1
 *   --- 以下 Plus の裏面パッド ---
 *   D11 (P0.15) : 行3
 *   D12 (P0.19) : 行4
 *   D13 (P1.01) : 行5
 *   D14 (P0.09, NFC1) : 行6
 *   D15 (P0.10, NFC2) : 列3
 *   D16 (P0.31) : 使用禁止 (電池電圧測定用 AIN7_BAT)
 *   D17 (P1.03) : 列2
 *   D18 (P1.05) : 列4
 *   D19 (P1.07) : 列5
 *
 * D8-D10 は SPI2(xiao_spi), D14/D15(NFC) を GPIO として使うため
 * spi2 無効化 + CONFIG_NFCT_PINS_AS_GPIOS=y が必要 (wobo40.conf)。
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,physical-layout = &physical_layout0;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		diode-direction = "col2row";
		wakeup-source;

		row-gpios
			= <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>	/* 行0: D1  */
			, <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>	/* 行1: D2  */
			, <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>	/* 行2: D3  */
			, <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>	/* 行3: D11 */
			, <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>	/* 行4: D12 */
			, <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>	/* 行5: D13 */
			, <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>	/* 行6: D14 (NFC1) */
			, <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>	/* 行7: D8  */
			;

		col-gpios
			= <&xiao_d 9 GPIO_ACTIVE_HIGH>	/* 列0: D9  */
			, <&xiao_d 10 GPIO_ACTIVE_HIGH>	/* 列1: D10 */
			, <&gpio1 3 GPIO_ACTIVE_HIGH>	/* 列2: D17 */
			, <&gpio0 10 GPIO_ACTIVE_HIGH>	/* 列3: D15 (NFC2) */
			, <&gpio1 5 GPIO_ACTIVE_HIGH>	/* 列4: D18 */
			, <&gpio1 7 GPIO_ACTIVE_HIGH>	/* 列5: D19 */
			;
	};

	/*
	 * 行2段重ね: 物理(r,c)は c<=5 なら RC(r,c)、c>=6 なら RC(r+4, c-6)。
	 * トラックボール位置 (物理3行目C8 = RC(7,1)) は除外。
	 */
	default_transform: keymap_transform0 {
		compatible = "zmk,matrix-transform";
		columns = <6>;
		rows = <8>;
		map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(6,5)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(7,0)         RC(7,2) RC(7,3) RC(7,4) RC(7,5)
		>;
	};

	physical_layout0: physical_layout_0 {
		compatible = "zmk,physical-layout";
		display-name = "Default";
		transform = <&default_transform>;
		kscan = <&kscan0>;
		keys  /*                    w   h    x    y  rot  rx  ry */
			= <&key_physical_attrs 100 100    0    0    0   0   0>
			, <&key_physical_attrs 100 100  100    0    0   0   0>
			, <&key_physical_attrs 100 100  200    0    0   0   0>
			, <&key_physical_attrs 100 100  300    0    0   0   0>
			, <&key_physical_attrs 100 100  400    0    0   0   0>
			, <&key_physical_attrs 100 100  500    0    0   0   0>
			, <&key_physical_attrs 100 100  600    0    0   0   0>
			, <&key_physical_attrs 100 100  700    0    0   0   0>
			, <&key_physical_attrs 100 100  800    0    0   0   0>
			, <&key_physical_attrs 100 100  900    0    0   0   0>
			, <&key_physical_attrs 100 100 1000    0    0   0   0>
			, <&key_physical_attrs 100 100 1100    0    0   0   0>
			, <&key_physical_attrs 100 100    0  100    0   0   0>
			, <&key_physical_attrs 100 100  100  100    0   0   0>
			, <&key_physical_attrs 100 100  200  100    0   0   0>
			, <&key_physical_attrs 100 100  300  100    0   0   0>
			, <&key_physical_attrs 100 100  400  100    0   0   0>
			, <&key_physical_attrs 100 100  500  100    0   0   0>
			, <&key_physical_attrs 100 100  600  100    0   0   0>
			, <&key_physical_attrs 100 100  700  100    0   0   0>
			, <&key_physical_attrs 100 100  800  100    0   0   0>
			, <&key_physical_attrs 100 100  900  100    0   0   0>
			, <&key_physical_attrs 100 100 1000  100    0   0   0>
			, <&key_physical_attrs 100 100 1100  100    0   0   0>
			, <&key_physical_attrs 100 100    0  200    0   0   0>
			, <&key_physical_attrs 100 100  100  200    0   0   0>
			, <&key_physical_attrs 100 100  200  200    0   0   0>
			, <&key_physical_attrs 100 100  300  200    0   0   0>
			, <&key_physical_attrs 100 100  400  200    0   0   0>
			, <&key_physical_attrs 100 100  500  200    0   0   0>
			, <&key_physical_attrs 100 100  600  200    0   0   0>
			, <&key_physical_attrs 100 100  700  200    0   0   0>
			, <&key_physical_attrs 100 100  800  200    0   0   0>
			, <&key_physical_attrs 100 100  900  200    0   0   0>
			, <&key_physical_attrs 100 100 1000  200    0   0   0>
			, <&key_physical_attrs 100 100 1100  200    0   0   0>
			, <&key_physical_attrs 100 100    0  300    0   0   0>
			, <&key_physical_attrs 100 100  100  300    0   0   0>
			, <&key_physical_attrs 100 100  200  300    0   0   0>
			, <&key_physical_attrs 100 100  300  300    0   0   0>
			, <&key_physical_attrs 100 100  400  300    0   0   0>
			, <&key_physical_attrs 100 100  500  300    0   0   0>
			, <&key_physical_attrs 100 100  600  300    0   0   0>
			/* 物理(3,7)=トラックボール位置はキーなし */
			, <&key_physical_attrs 100 100  800  300    0   0   0>
			, <&key_physical_attrs 100 100  900  300    0   0   0>
			, <&key_physical_attrs 100 100 1000  300    0   0   0>
			, <&key_physical_attrs 100 100 1100  300    0   0   0>
			;
	};

	trackball_listener {
		compatible = "zmk,input-listener";
		device = <&trackball>;
	};
};

/* D6/D7 は UART (TX/RX) に割り当てられているため無効化して GPIO として使う */
&uart0 {
	status = "disabled";
};

/* D4/D5 の I2C, D8-D10 の SPI2 (xiao_spi) も未使用のため無効化 */
&i2c0 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};

&pinctrl {
	/* SPI0: PMW3610 (3線SPI: MOSI/MISO を SDIO ピンに束ねる) */
	spi0_default: spi0_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 4)>,   /* D4 */
				<NRF_PSEL(SPIM_MOSI, 0, 5)>,      /* D5 (SDIO) */
				<NRF_PSEL(SPIM_MISO, 0, 5)>;      /* D5 (SDIO) */
		};
	};

	spi0_sleep: spi0_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 4)>,
				<NRF_PSEL(SPIM_MOSI, 0, 5)>,
				<NRF_PSEL(SPIM_MISO, 0, 5)>;
			low-power-enable;
		};
	};
};

&spi0 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-1 = <&spi0_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&xiao_d 6 GPIO_ACTIVE_LOW>;

	trackball: trackball@0 {
		status = "okay";
		compatible = "pixart,pmw3610";
		reg = <0>;
		spi-max-frequency = <2000000>;
		irq-gpios = <&xiao_d 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

		/* fn レイヤーを押している間はスクロール */
		scroll-layers = <2>;
		/* ボールを動かすと Mouse レイヤーが自動有効化 */
		automouse-layer = <1>;
	};
};
